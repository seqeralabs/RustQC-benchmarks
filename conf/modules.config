/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
        ext.when   = When clause to control module execution.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    //
    // Local module: RustQC RNA
    //
    withName: 'RUSTQC_RNA' {
        ext.args   = '--preseq-seed 1 --preseq-seg-len 100000000 --tin-seed 1 --junction-saturation-seed 1'
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //
    // Upstream modules: dupRadar
    // Mirrors nf-core/rnaseq publishDir layout
    //
    withName: 'DUPRADAR' {
        publishDir = [
            [
                path: { "${params.outdir}/dupradar/scatter_plot" },
                mode: params.publish_dir_mode,
                pattern: "*Dens.pdf"
            ],
            [
                path: { "${params.outdir}/dupradar/box_plot" },
                mode: params.publish_dir_mode,
                pattern: "*Boxplot.pdf"
            ],
            [
                path: { "${params.outdir}/dupradar/histogram" },
                mode: params.publish_dir_mode,
                pattern: "*Hist.pdf"
            ],
            [
                path: { "${params.outdir}/dupradar/gene_data" },
                mode: params.publish_dir_mode,
                pattern: "*Matrix.txt"
            ],
            [
                path: { "${params.outdir}/dupradar/intercepts_slope" },
                mode: params.publish_dir_mode,
                pattern: "*slope.txt"
            ]
        ]
    }

    //
    // Upstream modules: featureCounts
    //
    withName: 'SUBREAD_FEATURECOUNTS' {
        ext.args   = {
            def strandedness = 0
            if (meta.strandedness == 'forward') {
                strandedness = 1
            } else if (meta.strandedness == 'reverse') {
                strandedness = 2
            }
            "-B -C -g gene_biotype -t ${params.featurecounts_feature_type} -s ${strandedness}"
        }
        publishDir = [
            path: { "${params.outdir}/featurecounts" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Per-gene featureCounts (-g gene_id) for gene-level count comparison with RustQC
    withName: 'SUBREAD_FEATURECOUNTS_GENEID' {
        ext.args   = {
            def strandedness = 0
            if (meta.strandedness == 'forward') {
                strandedness = 1
            } else if (meta.strandedness == 'reverse') {
                strandedness = 2
            }
            "-B -C -g gene_id -t ${params.featurecounts_feature_type} -s ${strandedness}"
        }
        publishDir = [
            path: { "${params.outdir}/featurecounts_geneid" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //
    // Upstream modules: preseq
    // Mirrors nf-core/rnaseq ext.args
    //
    withName: 'PRESEQ_LCEXTRAP' {
        ext.args   = '-verbose -bam -seed 408 -seg_len 100000000'
        publishDir = [
            path: { "${params.outdir}/preseq" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //
    // Upstream modules: RSeQC
    //
    withName: 'RSEQC_BAMSTAT' {
        publishDir = [
            path: { "${params.outdir}/rseqc/bam_stat" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'RSEQC_INFEREXPERIMENT' {
        ext.args = '-s 2000000000'
        publishDir = [
            path: { "${params.outdir}/rseqc/infer_experiment" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'RSEQC_READDUPLICATION' {
        publishDir = [
            [
                path: { "${params.outdir}/rseqc/read_duplication/pdf" },
                mode: params.publish_dir_mode,
                pattern: "*.pdf"
            ],
            [
                path: { "${params.outdir}/rseqc/read_duplication/xls" },
                mode: params.publish_dir_mode,
                pattern: "*.xls"
            ],
            [
                path: { "${params.outdir}/rseqc/read_duplication/rscript" },
                mode: params.publish_dir_mode,
                pattern: "*.r"
            ]
        ]
    }

    withName: 'RSEQC_READDISTRIBUTION' {
        publishDir = [
            path: { "${params.outdir}/rseqc/read_distribution" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'RSEQC_JUNCTIONANNOTATION' {
        publishDir = [
            [
                path: { "${params.outdir}/rseqc/junction_annotation/pdf" },
                mode: params.publish_dir_mode,
                pattern: "*.pdf"
            ],
            [
                path: { "${params.outdir}/rseqc/junction_annotation/bed" },
                mode: params.publish_dir_mode,
                pattern: "*.bed"
            ],
            [
                path: { "${params.outdir}/rseqc/junction_annotation/xls" },
                mode: params.publish_dir_mode,
                pattern: "*.xls"
            ],
            [
                path: { "${params.outdir}/rseqc/junction_annotation/log" },
                mode: params.publish_dir_mode,
                pattern: "*.log"
            ],
            [
                path: { "${params.outdir}/rseqc/junction_annotation/rscript" },
                mode: params.publish_dir_mode,
                pattern: "*.r"
            ]
        ]
    }

    withName: 'RSEQC_JUNCTIONSATURATION' {
        publishDir = [
            [
                path: { "${params.outdir}/rseqc/junction_saturation/pdf" },
                mode: params.publish_dir_mode,
                pattern: "*.pdf"
            ],
            [
                path: { "${params.outdir}/rseqc/junction_saturation/rscript" },
                mode: params.publish_dir_mode,
                pattern: "*.r"
            ]
        ]
    }

    withName: 'RSEQC_INNERDISTANCE' {
        publishDir = [
            [
                path: { "${params.outdir}/rseqc/inner_distance/txt" },
                mode: params.publish_dir_mode,
                pattern: "*.txt",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ],
            [
                path: { "${params.outdir}/rseqc/inner_distance/pdf" },
                mode: params.publish_dir_mode,
                pattern: "*.pdf"
            ],
            [
                path: { "${params.outdir}/rseqc/inner_distance/rscript" },
                mode: params.publish_dir_mode,
                pattern: "*.r"
            ]
        ]
    }

    withName: 'RSEQC_TIN' {
        time   = 24.h

        publishDir = [
            path: { "${params.outdir}/rseqc/tin" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //
    // Upstream modules: Qualimap (+ name-sort)
    // Mirrors nf-core/rnaseq: name-sort BAM for qualimap performance optimisation
    //
    withName: 'SAMTOOLS_SORT_QUALIMAP' {
        ext.args   = '-n'
        ext.prefix = { "${meta.id}.namesorted" }
        publishDir = [
            enabled: false
        ]
    }

    withName: 'QUALIMAP_RNASEQ' {
        ext.args = '--sorted'
        publishDir = [
            path: { "${params.outdir}/qualimap" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //
    // Upstream modules: samtools
    //
    withName: 'SAMTOOLS_FLAGSTAT' {
        publishDir = [
            path: { "${params.outdir}/samtools" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SAMTOOLS_IDXSTATS' {
        publishDir = [
            path: { "${params.outdir}/samtools" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SAMTOOLS_STATS' {
        publishDir = [
            path: { "${params.outdir}/samtools" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //
    // MultiQC
    //
    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"${params.multiqc_title}\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
