/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config of the full-size run (--fullsize, workflows/fullsize.nf, tests/DATASETS.md): the
    resources of each step, the arguments of the alignment, and where the reusable STAR index
    and aligned BAM are published. It is the `fullsize` profile, e.g. `-profile fullsize` on
    Seqera Platform (.github/workflows/fullsize-seqera.yml), or `-profile docker,fullsize`.

    The CPU and memory below are estimates for 60 million read pairs against GRCh38: tune them
    after a run from the Platform's resource report (tests/DATASETS.md#what-seqera-platform-must-provide).
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    // The run: the profile selects the full-size mode (workflows/fullsize.nf), and the
    // upstream tools make the references the comparison reads
    fullsize     = true
    run_rustqc   = true
    run_upstream = true
    dataset      = 'hs_hcc1395_wts_fullsize'   // entry of tests/datasets.yml (expectations, sample name)

    // Largest machine a task may ask for: the compute environment must offer one this size
    fullsize_max_cpus   = 16
    fullsize_max_memory = '64.GB'
    fullsize_max_time   = '36.h'
}

process {
    resourceLimits = [
        cpus:   params.fullsize_max_cpus,
        memory: params.fullsize_max_memory as nextflow.util.MemoryUnit,
        time:   params.fullsize_max_time as nextflow.util.Duration,
    ]

    // --- Alignment (subworkflows/local/align_markdup) -------------------------------------

    // GRCh38 index: ~32 GB of RAM at the peak. Published to <star_index_dir>/star/ and
    // reused by the next run (workflows/fullsize.nf)
    withName: 'STAR_GENOMEGENERATE' {
        cpus   = 16
        memory = 64.GB
        time   = 6.h
        publishDir = [ path: { params.star_index_dir ?: "${params.outdir}/cache/star_index" }, mode: params.publish_dir_mode ]
    }

    // Same arguments as nf-core/rnaseq 3.28.0 (conf/modules/align_star.config, default salmon
    // branch) minus the transcriptome BAM; the BAM is sorted afterwards by SAMTOOLS_SORT
    withName: 'STAR_ALIGN' {
        cpus   = 16
        memory = 64.GB
        time   = 12.h
        ext.args = [
            '--outSAMtype BAM Unsorted',
            '--outSAMattributes NH HI AS NM MD',
            '--readFilesCommand zcat',
            '--twopassMode Basic',
            '--runRNGseed 0',
            '--outFilterMultimapNmax 20',
            '--alignSJDBoverhangMin 1',
            '--outSAMstrandField intronMotif',
        ].join(' ')
        publishDir = [ path: { "${params.outdir}/star" }, mode: params.publish_dir_mode, pattern: '*.Log.final.out' ]
    }

    withName: '.*ALIGN_MARKDUP:SAMTOOLS_SORT' {
        cpus   = 16
        memory = 48.GB
        ext.prefix = { "${meta.id}.sorted" }
        publishDir = [ path: { params.outdir }, enabled: false ]
    }

    // nf-core/rnaseq conf/modules/markduplicates.config. The BAM and its index are published to
    // <bam_dir>/ and reused by the next run
    withName: 'PICARD_MARKDUPLICATES' {
        cpus   = 4
        memory = 48.GB
        time   = 12.h
        ext.args   = '--ASSUME_SORTED true --REMOVE_DUPLICATES false --VALIDATION_STRINGENCY LENIENT --TMP_DIR tmp'
        ext.prefix = { "${meta.id}.markdup.sorted" }
        publishDir = [
            [ path: { params.bam_dir ?: "${params.outdir}/cache/bam" }, mode: params.publish_dir_mode, pattern: '*.bam' ],
            [ path: { "${params.outdir}/picard" },                              mode: params.publish_dir_mode, pattern: '*.metrics.txt' ],
        ]
    }

    withName: '.*ALIGN_MARKDUP:SAMTOOLS_INDEX' {
        ext.prefix = { "${meta.id}.markdup.sorted" }
        publishDir = [ path: { params.bam_dir ?: "${params.outdir}/cache/bam" }, mode: params.publish_dir_mode, pattern: '*.bai' ]
    }

    // infer_experiment.py's default 200,000-read sample, here and in the comparison (the
    // pipeline's `-s 2000000000` would read the whole BAM; RustQC samples like the default).
    // The alignment's report is published next to the BAM: it holds the strandedness that a
    // later run restores together with the cached BAM
    withName: 'RSEQC_INFEREXPERIMENT' {
        ext.args = ''
    }
    withName: '.*ALIGN_MARKDUP:RSEQC_INFEREXPERIMENT' {
        publishDir = [ path: { params.bam_dir ?: "${params.outdir}/cache/bam" }, mode: params.publish_dir_mode ]
    }
    withName: '.*ALIGN_MARKDUP:(GTF2BED|GUNZIP_FASTA|GUNZIP_GTF)' {
        publishDir = [ path: { params.outdir }, enabled: false ]
    }

    // --- RustQC and the upstream tools (workflows/rustqc-benchmarks.nf) -------------------

    withName: 'RUSTQC_RNA' {
        cpus   = 16
        memory = 64.GB
        time   = 12.h
    }
    withName: 'DUPRADAR|SUBREAD_FEATURECOUNTS|SUBREAD_FEATURECOUNTS_GENEID' {
        cpus   = 8
        memory = 48.GB
        time   = 24.h
    }
    withName: 'RSEQC_READDUPLICATION|RSEQC_READDISTRIBUTION|RSEQC_JUNCTIONANNOTATION|RSEQC_BAMSTAT|SAMTOOLS_STATS|SAMTOOLS_FLAGSTAT|SAMTOOLS_IDXSTATS' {
        cpus   = 2
        memory = 24.GB
        time   = 24.h
    }

    // Upstream tools that no registered check (tests/lib/checks/Checks.groovy) reads yet. They
    // are the slow ones on 60 million read pairs, hours each (TIN, inner_distance, Qualimap
    // with its name-sort, junction saturation), so they are skipped, as in
    // tests/rna/refgen/refgen.config. RustQC runs all of them anyway. Remove a tool from this
    // list when its check is added to the checks library, and check its runtime first.
    withName: 'RSEQC_TIN|RSEQC_JUNCTIONSATURATION|RSEQC_INNERDISTANCE|QUALIMAP_RNASEQ|SAMTOOLS_SORT_QUALIMAP|PRESEQ_LCEXTRAP|MULTIQC' {
        ext.when = false
    }

    // --- Comparison -----------------------------------------------------------------------

    withName: 'FULLSIZE_COMPARE' {
        cpus   = 2
        memory = 16.GB
        time   = 4.h
        publishDir = [ path: { params.outdir }, mode: params.publish_dir_mode ]   // <outdir>/report/
    }
}
