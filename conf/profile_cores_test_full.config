/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Profile cores test_full config — large S3 test data
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Uses the large GM12878 BAM from S3 without restrictive resource limits,
    so core profiling can test across the full range of CPU counts.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

includeConfig 'rna_test_full.config'

// Override resource limits — don't cap CPUs for core profiling
process {
    resourceLimits = [
        cpus:   64,
        memory: '28.GB',
        time:   '2.h',
    ]
}

// Separate output directory
params.outdir = "${projectDir}/results/profile_cores_large"
