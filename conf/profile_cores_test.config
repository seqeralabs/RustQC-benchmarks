/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Profile cores test config — small local test data
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Uses the same small test BAM/GTF but without restrictive resource limits,
    so core profiling can test across the full range of CPU counts.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

includeConfig 'rna_test.config'

// Override resource limits — don't cap CPUs for core profiling
process {
    resourceLimits = [
        cpus:   64,
        memory: '28.GB',
        time:   '2.h',
    ]
}

// Separate output directory
params.outdir = "${projectDir}/results/profile_cores_small"
