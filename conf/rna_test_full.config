/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running RNA benchmark suite with large test data
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input paths and parameters for the large RNA-seq dataset (S3).
    Use as: -profile rna_test_full,docker
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'RNA test profile (large)'
    config_profile_description = 'Large RNA-seq dataset from S3 for full benchmarking'

    // Input data — HTTPS URLs for public S3 buckets (avoids credential issues on Platform)
    // BED is derived from GTF using GTF2BED (matching nf-core/rnaseq behavior)
    // to ensure both RustQC and upstream tools use the same annotation source.
    bam     = 'https://nf-core-awsmegatests.s3-eu-west-1.amazonaws.com/rnaseq/results-3816d48abd9fab2eee41775b60b4eb8745e1fcaa/aligner_star_rsem/star_rsem/GM12878_REP1.markdup.sorted.bam'
    bai     = null  // Auto-generated by SAMTOOLS_INDEX in the pipeline
    gtf     = 'https://ngi-igenomes.s3.eu-west-1.amazonaws.com/igenomes/Homo_sapiens/Ensembl/GRCh37/Annotation/Genes/genes.gtf'

    // Sample metadata
    sample_id    = 'GM12878_REP1'
    paired       = true
    strandedness = 'reverse'

    // RustQC flags
    skip_dup_check    = false
    biotype_attribute = 'gene_type'
    rustqc_config     = null

    // Output
    outdir = 's3://seqera-node-red-tests/scratch/rustqc-benchmarks/results/rna_large'
}

process {
    resourceLimits = [
        cpus: 16,
        memory: '64.GB',
        time: '6.h'
    ]
}
