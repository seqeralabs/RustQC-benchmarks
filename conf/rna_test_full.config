/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running RNA benchmark suite with large test data
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input paths and parameters for the large RNA-seq dataset (S3).
    Use as: -profile rna_test_full,docker
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'RNA test profile (large)'
    config_profile_description = 'Large RNA-seq dataset from S3 for full benchmarking'

    // Input data (S3)
    bam     = 's3://nf-core-awsmegatests/rnaseq/results-3816d48abd9fab2eee41775b60b4eb8745e1fcaa/aligner_star_rsem/star_rsem/GM12878_REP1.markdup.sorted.bam'
    bai     = 's3://nf-core-awsmegatests/rnaseq/results-3816d48abd9fab2eee41775b60b4eb8745e1fcaa/aligner_star_rsem/star_rsem/GM12878_REP1.markdup.sorted.bam.bai'
    gtf     = null  // TODO: host large GTF on S3
    bed     = null  // TODO: host large BED on S3

    // Sample metadata
    sample_id    = 'GM12878_REP1'
    paired       = true
    strandedness = 'unstranded'

    // RustQC flags
    skip_dup_check    = false
    biotype_attribute = 'gene_type'
    rustqc_config     = "${projectDir}/test-data/rna/large/config.yaml"

    // Output
    outdir = "${projectDir}/results/rna_large"
}

process {
    resourceLimits = [
        cpus: 16,
        memory: '64.GB',
        time: '6.h'
    ]
}

aws {
    client {
        anonymous = true
    }
}
