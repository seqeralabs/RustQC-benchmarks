/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running RNA benchmark suite with small test data
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input paths and parameters for the small RNA-seq test dataset.
    Use as: -profile rna_test,docker
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'RNA test profile (small)'
    config_profile_description = 'Small RNA-seq test dataset for benchmarking'

    // Input data
    bam     = "${projectDir}/test-data/rna/small/test.bam"
    bai     = "${projectDir}/test-data/rna/small/test.bam.bai"
    gtf     = "${projectDir}/test-data/rna/small/chr6.gtf.gz"
    bed     = "${projectDir}/test-data/rna/small/chr6.bed"

    // Sample metadata
    sample_id    = 'test'
    paired       = true
    strandedness = 'reverse'

    // RustQC flags
    skip_dup_check    = true
    biotype_attribute = null
    rustqc_config     = null

    // Output
    outdir = "${projectDir}/results/rna_small"
}

process {
    resourceLimits = [
        cpus: 2,
        memory: '6.GB',
        time: '1.h'
    ]
}
