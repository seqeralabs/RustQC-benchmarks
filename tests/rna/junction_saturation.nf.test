nextflow_process {

    name "Test RUSTQC junction_saturation output"
    script "../../modules/local/rustqc_rna.nf"
    process "RUSTQC_RNA"

    tag "rna"
    tag "junction_saturation"
    tag "small"

    test("small dataset - junction_saturation matches upstream RSeQC") {

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'unstranded' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def rseqcFiles = process.out.results[0][1].flatten()

            // Junction saturation R script (contains the data)
            def actualRscript = rseqcFiles.find {
                it.toString().contains('junction_saturation') && it.toString().endsWith('.r')
            }

            assert actualRscript : "junctionSaturation_plot.r not found in RUSTQC_RNA rseqc output"
            CompareUtils.textMatch(
                path(actualRscript).readLines(),
                path("${projectDir}/snapshots/rna/small/rseqc/junction_saturation.junctionSaturation_plot.r").readLines()
            )
        }
    }
}
