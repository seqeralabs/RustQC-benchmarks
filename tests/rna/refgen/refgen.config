/*
 * Config for tests/rna/refgen/references.nf.test.
 *
 * Keep going when an upstream tool fails on a dataset: the other tools' references are still
 * written, and the missing ones are reported (the dataset then marks that tool
 * `upstream_error` in tests/datasets.yml).
 */
process {
    withName: '.*' {
        errorStrategy = 'ignore'
    }

    // Upstream tools whose outputs no registered check (tests/lib/checks/Checks.groovy) reads
    // yet. They are the slow ones (TIN, Qualimap, junction saturation, ...), so skip them; remove
    // a tool from this list when its check is added to the checks library. (The featureCounts
    // biotype run is not listed: a selector for it would also match its _GENEID alias.)
    withName: 'RSEQC_TIN|RSEQC_JUNCTIONSATURATION|RSEQC_INNERDISTANCE|QUALIMAP_RNASEQ|SAMTOOLS_SORT_QUALIMAP|PRESEQ_LCEXTRAP|MULTIQC' {
        ext.when = false
    }
}
