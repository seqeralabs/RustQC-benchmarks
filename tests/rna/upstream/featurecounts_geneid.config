// Test-specific config: override ext.args for per-gene featureCounts (-g gene_id).
// Mirrors SUBREAD_FEATURECOUNTS_GENEID in conf/modules.config, which generated
// snapshots/rna/small/featurecounts_geneid/ (its header records "-s 2").
process {
    withName: 'SUBREAD_FEATURECOUNTS' {
        ext.args = {
            def strandedness = 0
            if (meta.strandedness == 'forward') {
                strandedness = 1
            } else if (meta.strandedness == 'reverse') {
                strandedness = 2
            }
            "-B -C -g gene_id -t ${params.featurecounts_feature_type} -s ${strandedness}"
        }
    }
}
