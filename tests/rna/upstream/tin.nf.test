nextflow_process {

    name "Test upstream RSeQC TIN"
    script "../../../modules/nf-core/rseqc/tin/main.nf"
    process "RSEQC_TIN"

    tag "upstream"
    tag "rna"
    tag "tin"
    tag "small"

    test("small dataset - upstream TIN") {

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'reverse' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.eautils.bed", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def summaryFile = process.out.txt[0][1]
            def xlsFile     = process.out.xls[0][1]
            assert path(summaryFile).exists()
            assert path(xlsFile).exists()

            // Byte-exact against the committed reference. The reference was made with this
            // module on an FMA-capable CPU (see "Reference platform" in tests/README.md), on the BED
            // that nf-core/rnaseq >= 3.25 builds with eautils/gtf2bed from chr6.gtf.gz; rows follow
            // the BED order.
            def refDir = "${projectDir}/snapshots/rna/small/rseqc/tin"
            assert path(summaryFile).md5 == path("${refDir}/test.summary.txt").md5 : "TIN summary differs from the reference"
            assert path(xlsFile).md5     == path("${refDir}/test.tin.xls").md5     : "TIN xls differs from the reference"
        }
    }
}
