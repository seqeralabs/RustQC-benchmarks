// Test-specific config: featureCounts with -M (multi-mapping) and/or -O
// (multi-overlapping). Same arguments as conf/modules.config, plus the extra
// flags. Each test in featurecounts_mo.nf.test sets the two params below.
params {
    featurecounts_mo_attribute = 'gene_id'   // -g: gene_id or gene_biotype
    featurecounts_mo_args      = ''          // '-M', '-O' or '-M -O'
}

process {
    withName: 'SUBREAD_FEATURECOUNTS' {
        ext.args = {
            def strandedness = 0
            if (meta.strandedness == 'forward') {
                strandedness = 1
            } else if (meta.strandedness == 'reverse') {
                strandedness = 2
            }
            "-B -C -g ${params.featurecounts_mo_attribute} -t ${params.featurecounts_feature_type} -s ${strandedness} ${params.featurecounts_mo_args}"
        }
    }
}
