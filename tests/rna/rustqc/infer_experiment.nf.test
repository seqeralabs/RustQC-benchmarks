nextflow_process {

    name "Test RUSTQC infer_experiment output"
    script "../../../modules/local/rustqc_rna.nf"
    process "RUSTQC_RNA"

    tag "rustqc"
    tag "rna"
    tag "infer_experiment"
    tag "small"

    // ── Regression: detect changes between RustQC versions ──────────
    test("infer_experiment - regression") {

        tag "regression"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'unstranded' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def rustqcDir = process.out.results[0][1]
            def actualFile = "${rustqcDir}/rseqc/infer_experiment/test.infer_experiment.txt"
            assert path(actualFile).exists() : "infer_experiment.txt not found in: ${rustqcDir}"

            // Filter non-deterministic lines before snapshotting
            def lines = path(actualFile).readLines().findAll { line ->
                !line.startsWith('This is') && line.trim() != ''
            }
            snapshot(lines).match("infer_experiment_regression")
        }
    }

    // ── Crosscheck: validate RustQC output matches upstream RSeQC ───
    test("infer_experiment - crosscheck vs upstream") {

        tag "crosscheck"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'unstranded' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def rustqcDir = process.out.results[0][1]
            def actualFile = "${rustqcDir}/rseqc/infer_experiment/test.infer_experiment.txt"
            assert path(actualFile).exists() : "infer_experiment.txt not found in: ${rustqcDir}"

            // Exact text match against upstream reference (skip version header)
            // Benchmark report confirms: identical on small dataset
            CompareUtils.textMatch(
                path(actualFile).readLines(),
                path("${projectDir}/snapshots/rna/small/rseqc/infer_experiment/infer_experiment.txt").readLines(),
                ['This is']
            )
        }
    }
}
