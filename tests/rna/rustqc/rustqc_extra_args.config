// Test-specific config for RustQC features that need extra CLI flags
// (split_bam.nf.test, featurecounts_mo.nf.test).
//
// Appends params.rustqc_extra_args to the RUSTQC_RNA ext.args from
// conf/modules.config. Each test sets rustqc_extra_args in its params block.
//
// split_bam and featureCounts -M/-O come from RustQC PR #191 and are not in
// ghcr.io/seqeralabs/rustqc:dev until it is merged and published. Until then,
// point the tests at an image built from that PR by exporting RUSTQC_IMAGE:
//     RUSTQC_IMAGE=<registry>/rustqc:<pr-191-tag> nf-test test --tag split_bam
params {
    rustqc_extra_args = ''
    rustqc_image      = System.getenv('RUSTQC_IMAGE') ?: 'ghcr.io/seqeralabs/rustqc:dev'
}

process {
    withName: 'RUSTQC_RNA' {
        ext.args = { "--preseq-seed 408 --preseq-seg-len 100000000 --tin-seed 1 --junction-saturation-seed 1 ${params.rustqc_extra_args}" }
    }
}
