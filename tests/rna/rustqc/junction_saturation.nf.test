nextflow_process {

    name "Test RUSTQC junction_saturation output"
    script "../../../modules/local/rustqc_rna.nf"
    process "RUSTQC_RNA"

    tag "rustqc"
    tag "rna"
    tag "junction_saturation"
    tag "small"

    // ── Regression: detect changes between RustQC versions ──────────
    test("junction_saturation - regression") {

        tag "regression"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'unstranded' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def allFiles = process.out.results[0][1].flatten()
            def rFile = allFiles.find { it.toString().endsWith('junctionSaturation_plot.r') }
            assert rFile : "junctionSaturation_plot.r not found in: ${allFiles}"

            // Snapshot full content for regression tracking
            def lines = path(rFile).readLines().findAll { it.trim() != '' }
            snapshot(lines).match("junction_saturation_regression")
        }
    }

    // ── Crosscheck: validate RustQC output matches upstream RSeQC ───
    test("junction_saturation - crosscheck vs upstream") {

        tag "crosscheck"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'unstranded' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def allFiles = process.out.results[0][1].flatten()
            def rFile = allFiles.find { it.toString().endsWith('junctionSaturation_plot.r') }
            assert rFile : "junctionSaturation_plot.r not found in: ${allFiles}"

            def upstreamFile = "${projectDir}/snapshots/rna/small/rseqc/junction_saturation/junctionSaturation_plot.r"

            // Exact text match on small dataset
            // Benchmark report confirms: identical on small dataset
            // (large dataset has 0.03% stochastic variance — not relevant for small)
            CompareUtils.textMatch(
                path(rFile).readLines(),
                path(upstreamFile).readLines()
            )
        }
    }
}
