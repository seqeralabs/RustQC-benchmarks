nextflow_process {

    name "Test RUSTQC junction_saturation output"
    script "../../../modules/local/rustqc_rna.nf"
    process "RUSTQC_RNA"

    tag "rustqc"
    tag "rna"
    tag "junction_saturation"
    tag "small"

    // ── Regression: detect changes between RustQC versions ──────────
    test("junction_saturation - regression") {

        tag "regression"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'reverse' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def rustqcDir = process.out.results[0][1]
            def rFile = "${rustqcDir}/rseqc/junction_saturation/test.junctionSaturation_plot.r"
            assert path(rFile).exists() : "junctionSaturation_plot.r not found in: ${rustqcDir}"

            // Snapshot full content for regression tracking
            def lines = path(rFile).readLines().findAll { it.trim() != '' }
            snapshot(lines).match("junction_saturation_regression")
        }
    }

    // ── Crosscheck: validate RustQC output matches upstream RSeQC ───
    test("junction_saturation - crosscheck vs upstream") {

        tag "crosscheck"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'reverse' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def rustqcDir = process.out.results[0][1]
            def rFile = "${rustqcDir}/rseqc/junction_saturation/test.junctionSaturation_plot.r"
            assert path(rFile).exists() : "junctionSaturation_plot.r not found in: ${rustqcDir}"

            def upstreamFile = "${projectDir}/snapshots/rna/small/rseqc/junction_saturation/junctionSaturation_plot.r"

            // Junction saturation re-counts junctions on random 5%..100% subsamples of
            // the reads. RustQC and RSeQC draw from different random streams, so the
            // intermediate points legitimately differ (measured up to 5.2% known,
            // 6.0% all, 17.5% novel) and are not compared. Everything deterministic is
            // compared exactly:
            //   - x, the sampling percentages
            //   - the 100% point of y (known), z (all) and w (novel) junctions
            //   - z == y + w at every sampling point (all = known + novel)
            //   - every other line of the R script except pdf(), which embeds a path
            def parseArrays = { lines ->
                lines.findAll { it ==~ /^[xyzw]=c\(.*\)$/ }.collectEntries { line ->
                    [(line[0]): line.substring(4, line.length() - 1).split(',').collect { it as Integer }]
                }
            }
            def actualLines   = path(rFile).readLines()
            def expectedLines = path(upstreamFile).readLines()
            def actual   = parseArrays(actualLines)
            def expected = parseArrays(expectedLines)

            assert actual.keySet() == ['x', 'y', 'z', 'w'] as Set : \
                "Expected x/y/z/w arrays in RustQC R script, found: ${actual.keySet()}"
            assert actual.x == expected.x : \
                "Sampling percentages differ: RustQC=${actual.x} upstream=${expected.x}"
            [y: 'known', z: 'all', w: 'novel'].each { key, label ->
                assert actual[key].size() == actual.x.size() : \
                    "${label} junctions: ${actual[key].size()} points for ${actual.x.size()} sampling percentages"
                assert actual[key][-1] == expected[key][-1] : \
                    "${label} junctions at 100%: RustQC=${actual[key][-1]} upstream=${expected[key][-1]}"
            }
            actual.x.indices.each { i ->
                assert actual.z[i] == actual.y[i] + actual.w[i] : \
                    "At ${actual.x[i]}%: all (${actual.z[i]}) != known (${actual.y[i]}) + novel (${actual.w[i]})"
            }
            CompareUtils.textMatch(actualLines, expectedLines, ['pdf(', 'y=c(', 'z=c(', 'w=c('])
        }
    }
}
