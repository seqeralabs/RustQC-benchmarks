nextflow_process {

    name "Test RUSTQC junction_saturation output"
    script "../../../modules/local/rustqc_rna.nf"
    process "RUSTQC_RNA"

    tag "rustqc"
    tag "rna"
    tag "junction_saturation"
    tag "small"

    // ── Regression: detect changes between RustQC versions ──────────
    test("junction_saturation - regression") {

        tag "regression"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'unstranded' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def rustqcDir = process.out.results[0][1]
            def rFile = "${rustqcDir}/rseqc/junction_saturation/test.junctionSaturation_plot.r"
            assert path(rFile).exists() : "junctionSaturation_plot.r not found in: ${rustqcDir}"

            // Snapshot full content for regression tracking
            def lines = path(rFile).readLines().findAll { it.trim() != '' }
            snapshot(lines).match("junction_saturation_regression")
        }
    }

    // ── Crosscheck: validate RustQC output matches upstream RSeQC ───
    test("junction_saturation - crosscheck vs upstream") {

        tag "crosscheck"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'unstranded' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def rustqcDir = process.out.results[0][1]
            def rFile = "${rustqcDir}/rseqc/junction_saturation/test.junctionSaturation_plot.r"
            assert path(rFile).exists() : "junctionSaturation_plot.r not found in: ${rustqcDir}"

            def upstreamFile = "${projectDir}/snapshots/rna/small/rseqc/junction_saturation/junctionSaturation_plot.r"

            // Junction saturation uses random subsampling — intermediate values
            // are stochastic (~2-10% variance). The 100% values are deterministic.
            // Compare only the 100% sampling point (last element of each array).
            def extractLastValues = { lines ->
                def vals = [:]
                lines.each { line ->
                    def trimmed = line.trim()
                    if (trimmed.startsWith('y=c(')) vals['known'] = trimmed.replaceAll(/.*,/, '').replace(')', '') as Integer
                    if (trimmed.startsWith('z=c(')) vals['all']   = trimmed.replaceAll(/.*,/, '').replace(')', '') as Integer
                    if (trimmed.startsWith('w=c(')) vals['novel'] = trimmed.replaceAll(/.*,/, '').replace(')', '') as Integer
                }
                vals
            }

            def actualVals   = extractLastValues(path(rFile).readLines())
            def expectedVals = extractLastValues(path(upstreamFile).readLines())

            assert actualVals.known == expectedVals.known : \
                "known junctions at 100%: ${actualVals.known} vs ${expectedVals.known}"
            assert actualVals.all == expectedVals.all : \
                "all junctions at 100%: ${actualVals.all} vs ${expectedVals.all}"
            assert actualVals.novel == expectedVals.novel : \
                "novel junctions at 100%: ${actualVals.novel} vs ${expectedVals.novel}"

            // Also verify the R script structure is valid
            def lines = path(rFile).readLines().findAll { it.trim() != '' }
            assert lines.any { it.contains('pdf(') } : "Missing pdf() call"
            assert lines.any { it.startsWith('x=c(') } : "Missing x array"
            assert lines.any { it.startsWith('y=c(') } : "Missing y array (known)"
            assert lines.any { it.startsWith('z=c(') } : "Missing z array (all)"
            assert lines.any { it.startsWith('w=c(') } : "Missing w array (novel)"
            assert lines.any { it.contains('dev.off()') } : "Missing dev.off()"
        }
    }
}
