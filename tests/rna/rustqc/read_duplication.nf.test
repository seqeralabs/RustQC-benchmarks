nextflow_process {

    name "Test RUSTQC read_duplication output"
    script "../../../modules/local/rustqc_rna.nf"
    process "RUSTQC_RNA"

    tag "rustqc"
    tag "rna"
    tag "read_duplication"
    tag "small"

    // ── Regression: detect changes between RustQC versions ──────────
    test("read_duplication - regression") {

        tag "regression"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'unstranded' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def allFiles = process.out.results[0][1].flatten()
            def posFile = allFiles.find { it.toString().endsWith('pos.DupRate.xls') }
            def seqFile = allFiles.find { it.toString().endsWith('seq.DupRate.xls') }
            assert posFile : "pos.DupRate.xls not found in: ${allFiles}"
            assert seqFile : "seq.DupRate.xls not found in: ${allFiles}"

            // Snapshot both TSV files for regression tracking
            snapshot(
                pos: path(posFile).readLines(),
                seq: path(seqFile).readLines()
            ).match("read_duplication_regression")
        }
    }

    // ── Crosscheck: validate RustQC output matches upstream RSeQC ───
    test("read_duplication - crosscheck vs upstream") {

        tag "crosscheck"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'unstranded' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def allFiles = process.out.results[0][1].flatten()
            def posFile = allFiles.find { it.toString().endsWith('pos.DupRate.xls') }
            def seqFile = allFiles.find { it.toString().endsWith('seq.DupRate.xls') }
            assert posFile : "pos.DupRate.xls not found in: ${allFiles}"
            assert seqFile : "seq.DupRate.xls not found in: ${allFiles}"

            // Byte-identical match via md5 hash (gold standard)
            // RustQC produces identical output to upstream RSeQC for read_duplication
            def upstreamDir = "${projectDir}/snapshots/rna/small/rseqc/read_duplication"

            assert path(posFile).md5 == path("${upstreamDir}/pos.DupRate.xls").md5 : \
                "pos.DupRate.xls md5 mismatch"
            assert path(seqFile).md5 == path("${upstreamDir}/seq.DupRate.xls").md5 : \
                "seq.DupRate.xls md5 mismatch"
        }
    }
}
