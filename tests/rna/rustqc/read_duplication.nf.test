nextflow_process {

    name "Test RUSTQC read_duplication output"
    script "../../../modules/local/rustqc_rna.nf"
    process "RUSTQC_RNA"

    tag "rustqc"
    tag "rna"
    tag "read_duplication"
    tag "small"

    test("small dataset - read_duplication matches upstream RSeQC") {

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'unstranded' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def allFiles = process.out.results[0][1].flatten()

            def actualPos = allFiles.find {
                it.toString().contains('pos') && it.toString().endsWith('.DupRate.xls')
            }
            def actualSeq = allFiles.find {
                it.toString().contains('seq') && it.toString().endsWith('.DupRate.xls')
            }

            assertAll(
                {
                    assert actualPos : "pos.DupRate.xls not found in: ${allFiles}"
                    CompareUtils.tsvMatch(
                        path(actualPos).readLines(),
                        path("${projectDir}/snapshots/rna/small/rseqc/read_duplication.pos.DupRate.xls").readLines(),
                        [tolerance: 0.0]
                    )
                },
                {
                    assert actualSeq : "seq.DupRate.xls not found in: ${allFiles}"
                    CompareUtils.tsvMatch(
                        path(actualSeq).readLines(),
                        path("${projectDir}/snapshots/rna/small/rseqc/read_duplication.seq.DupRate.xls").readLines(),
                        [tolerance: 0.0]
                    )
                }
            )

            // Snapshot for regression tracking
            snapshot(
                pos: path(actualPos).readLines(),
                seq: path(actualSeq).readLines()
            ).match("read_duplication_output")
        }
    }
}
