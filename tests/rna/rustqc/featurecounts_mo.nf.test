        then {
            assert process.success

            def fcDir      = "${process.out.results[0][1]}/featurecounts"
            def geneRef    = "${projectDir}/snapshots/rna/small/featurecounts_mo/O/gene_id"
            def biotypeRef = "${projectDir}/snapshots/rna/small/featurecounts_mo/O/gene_biotype"

            // ── Gene level ────────────────────────────────────────────────
            // Geneid, Length and count must be identical, row for row
