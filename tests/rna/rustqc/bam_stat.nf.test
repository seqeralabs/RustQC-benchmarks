nextflow_process {

    name "Test RUSTQC bam_stat output"
    script "../../../modules/local/rustqc_rna.nf"
    process "RUSTQC_RNA"

    tag "rustqc"
    tag "rna"
    tag "bam_stat"
    tag "small"

    test("small dataset - bam_stat matches upstream RSeQC") {

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'unstranded' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def allFiles = process.out.results[0][1].flatten()
            def actualFile = allFiles.find { it.toString().endsWith('bam_stat.txt') }
            assert actualFile : "bam_stat.txt not found in: ${allFiles}"

            // Compare against upstream reference
            CompareUtils.textMatch(
                path(actualFile).readLines(),
                path("${projectDir}/snapshots/rna/small/rseqc/bam_stat.txt").readLines(),
                ['Load BAM', 'processing']
            )

            // Snapshot for regression tracking
            snapshot(
                path(actualFile).readLines()
            ).match("bam_stat_output")
        }
    }
}
