nextflow_process {

    name "Test RUSTQC junction_annotation output"
    script "../../../modules/local/rustqc_rna.nf"
    process "RUSTQC_RNA"

    tag "rustqc"
    tag "rna"
    tag "junction_annotation"
    tag "small"

    // ── Regression: detect changes between RustQC versions ──────────
    test("junction_annotation - regression") {

        tag "regression"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'unstranded' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def allFiles = process.out.results[0][1].flatten()
            def bedFile = allFiles.find { it.toString().endsWith('.junction.bed') }
            def xlsFile = allFiles.find { it.toString().endsWith('.junction.xls') }
            def txtFile = allFiles.find { it.toString().endsWith('junction_annotation.txt') ||
                                          it.toString().endsWith('junction_annotation.log') }
            assert bedFile : ".junction.bed not found in: ${allFiles}"
            assert xlsFile : ".junction.xls not found in: ${allFiles}"

            // Snapshot sorted BED and XLS for stable regression comparison
            def bedLines = path(bedFile).readLines().sort()
            def xlsLines = path(xlsFile).readLines()
            snapshot(
                bed: bedLines,
                xls: xlsLines
            ).match("junction_annotation_regression")
        }
    }

    // ── Crosscheck: validate RustQC output matches upstream RSeQC ───
    test("junction_annotation - crosscheck vs upstream") {

        tag "crosscheck"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'unstranded' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def allFiles = process.out.results[0][1].flatten()
            def bedFile = allFiles.find { it.toString().endsWith('.junction.bed') }
            def xlsFile = allFiles.find { it.toString().endsWith('.junction.xls') }
            assert bedFile : ".junction.bed not found in: ${allFiles}"
            assert xlsFile : ".junction.xls not found in: ${allFiles}"

            def upstreamDir = "${projectDir}/snapshots/rna/small/rseqc/junction_annotation"

            // BED: exact match after sorting (line order may differ)
            // Benchmark report confirms: identical on small dataset
            def actualBed   = path(bedFile).readLines().sort()
            def expectedBed = path("${upstreamDir}/junction.bed").readLines().sort()
            CompareUtils.tsvMatch(actualBed, expectedBed, [tolerance: 0.0])

            // XLS: exact TSV match
            CompareUtils.tsvMatch(
                path(xlsFile).readLines(),
                path("${upstreamDir}/junction.xls").readLines(),
                [tolerance: 0.0]
            )
        }
    }
}
