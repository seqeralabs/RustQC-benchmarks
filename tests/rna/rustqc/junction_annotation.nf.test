nextflow_process {

    name "Test RUSTQC junction_annotation output"
    script "../../../modules/local/rustqc_rna.nf"
    process "RUSTQC_RNA"

    tag "rustqc"
    tag "rna"
    tag "junction_annotation"
    tag "small"

    // ── Regression: detect changes between RustQC versions ──────────
    test("junction_annotation - regression") {

        tag "regression"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'reverse' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def rustqcDir = process.out.results[0][1]
            def bedFile = "${rustqcDir}/rseqc/junction_annotation/test.junction.bed"
            def xlsFile = "${rustqcDir}/rseqc/junction_annotation/test.junction.xls"
            assert path(bedFile).exists() : ".junction.bed not found in: ${rustqcDir}"
            assert path(xlsFile).exists() : ".junction.xls not found in: ${rustqcDir}"

            // Snapshot sorted BED and XLS for stable regression comparison
            def bedLines = path(bedFile).readLines().sort()
            def xlsLines = path(xlsFile).readLines()
            snapshot(
                bed: bedLines,
                xls: xlsLines
            ).match("junction_annotation_regression")
        }
    }

    // ── Crosscheck: validate RustQC output matches upstream RSeQC ───
    test("junction_annotation - crosscheck vs upstream") {

        tag "crosscheck"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'reverse' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def rustqcDir = process.out.results[0][1]
            def bedFile      = "${rustqcDir}/rseqc/junction_annotation/test.junction.bed"
            def xlsFile      = "${rustqcDir}/rseqc/junction_annotation/test.junction.xls"
            def interactFile = "${rustqcDir}/rseqc/junction_annotation/test.junction.Interact.bed"
            def logFile      = "${rustqcDir}/rseqc/junction_annotation/test.junction_annotation.log"
            assert path(bedFile).exists()      : ".junction.bed not found in: ${rustqcDir}"
            assert path(xlsFile).exists()      : ".junction.xls not found in: ${rustqcDir}"
            assert path(interactFile).exists() : ".junction.Interact.bed not found in: ${rustqcDir}"
            assert path(logFile).exists()      : ".junction_annotation.log not found in: ${rustqcDir}"

            def upstreamDir = "${projectDir}/snapshots/rna/small/rseqc/junction_annotation"

            // Measured: BED and XLS are byte-identical to RSeQC junction_annotation.py,
            // row order included, so no sorting is needed.
            assert path(bedFile).md5 == path("${upstreamDir}/junction.bed").md5 : \
                "junction.bed differs from upstream RSeQC"
            assert path(xlsFile).md5 == path("${upstreamDir}/junction.xls").md5 : \
                "junction.xls differs from upstream RSeQC"

            // Interact BED: identical except the track header, whose description
            // names the input BAM path.
            CompareUtils.textMatch(
                path(interactFile).readLines(),
                path("${upstreamDir}/junction.Interact.bed").readLines(),
                ['track ']
            )

            // Log: the splicing event and junction summary is identical. Only the
            // first line differs: it names the annotation that was read (RustQC reads
            // the GTF, RSeQC the BED derived from it).
            CompareUtils.textMatch(
                path(logFile).readLines(),
                path("${upstreamDir}/junction_annotation.txt").readLines(),
                ['Reading reference']
            )
        }
    }
}
