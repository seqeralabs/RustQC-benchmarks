nextflow_process {

    name "Test RUSTQC junction_annotation output"
    script "../../../modules/local/rustqc_rna.nf"
    process "RUSTQC_RNA"

    tag "rustqc"
    tag "rna"
    tag "junction_annotation"
    tag "small"

    test("small dataset - junction_annotation matches upstream RSeQC") {

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'unstranded' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def allFiles = process.out.results[0][1].flatten()

            def actualBed = allFiles.find { it.toString().endsWith('.junction.bed') }
            def actualXls = allFiles.find { it.toString().endsWith('.junction.xls') }
            def actualTxt = allFiles.find {
                it.toString().contains('junction_annotation') &&
                (it.toString().endsWith('.txt') || it.toString().endsWith('.log'))
            }

            // Cross-tool comparison: junction annotation outputs may differ in
            // sort order and summary format between RustQC and upstream RSeQC.
            // We compare sorted content and use generous tolerances.
            assertAll(
                {
                    assert actualBed : "junction.bed not found in: ${allFiles}"
                    // Sort both BED files before comparing (order may differ)
                    def actualLines = path(actualBed).readLines().sort()
                    def expectedLines = path("${projectDir}/snapshots/rna/small/rseqc/junction_annotation/junction.bed").readLines().sort()
                    assert actualLines.size() > 0 : "junction.bed is empty"
                    // Check line count is within 10% (RustQC may find slightly different junctions)
                    def ratio = actualLines.size() / (double) expectedLines.size()
                    assert ratio > 0.8 && ratio < 1.2 : "junction.bed line count differs significantly: ${actualLines.size()} vs ${expectedLines.size()}"
                },
                {
                    assert actualXls : "junction.xls not found in: ${allFiles}"
                    def actualLines = path(actualXls).readLines().sort()
                    def expectedLines = path("${projectDir}/snapshots/rna/small/rseqc/junction_annotation/junction.xls").readLines().sort()
                    assert actualLines.size() > 0 : "junction.xls is empty"
                    def ratio = actualLines.size() / (double) expectedLines.size()
                    assert ratio > 0.8 && ratio < 1.2 : "junction.xls line count differs significantly: ${actualLines.size()} vs ${expectedLines.size()}"
                },
                {
                    assert actualTxt : "junction_annotation.txt not found in: ${allFiles}"
                    // Just check it has content (summary format differs between implementations)
                    def lines = path(actualTxt).readLines()
                    assert lines.size() > 0 : "junction_annotation.txt is empty"
                }
            )

            // Snapshot for regression tracking
            snapshot(
                bed: path(actualBed).readLines(),
                xls: path(actualXls).readLines()
            ).match("junction_annotation_output")
        }
    }
}
