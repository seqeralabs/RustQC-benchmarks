nextflow_process {

    name "Test RustQC preseq lc_extrap output"
    script "../../../modules/local/rustqc_rna.nf"
    process "RUSTQC_RNA"

    tag "rustqc"
    tag "rna"
    tag "preseq"
    tag "small"

    test("preseq - regression") {

        tag "regression"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'reverse' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def rustqcDir = process.out.results[0][1]
            def actualFile = "${rustqcDir}/preseq/test.lc_extrap.txt"
            assert path(actualFile).exists() : "preseq lc_extrap not found in: ${rustqcDir}"

            snapshot(
                path(actualFile).readLines()
            ).match("preseq_regression")
        }
    }

    test("preseq - crosscheck vs upstream") {

        tag "crosscheck"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'reverse' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def rustqcDir = process.out.results[0][1]
            def actualFile = "${rustqcDir}/preseq/test.lc_extrap.txt"
            assert path(actualFile).exists() : "preseq lc_extrap not found in: ${rustqcDir}"

            def upstreamFile = "${projectDir}/snapshots/rna/small/preseq/test.lc_extrap.txt"

            // preseq lc_extrap bootstraps its estimates. RustQC calls the same C++
            // std::mt19937 + std::binomial_distribution as upstream preseq, with the
            // same seed (408, via ext.args in conf/modules.config), so on the same
            // platform the output is byte-identical. Measured identical on Linux.
            // Platform note: this check is only valid on Linux, which is all CI runs.
            // On macOS, libc++ draws a different binomial stream and the values
            // differ by up to ~18%.
            assert path(actualFile).md5 == path(upstreamFile).md5 : \
                "lc_extrap.txt differs from upstream preseq (${upstreamFile})"
        }
    }
}
