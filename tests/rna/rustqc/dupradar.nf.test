nextflow_process {

    name "Test RUSTQC dupradar output"
    script "../../../modules/local/rustqc_rna.nf"
    process "RUSTQC_RNA"

    tag "rustqc"
    tag "rna"
    tag "dupradar"
    tag "small"

    // ── Regression: detect changes between RustQC versions ──────────
    test("dupradar - regression") {

        tag "regression"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'unstranded' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def rustqcDir = process.out.results[0][1]
            def matrixFile = "${rustqcDir}/dupradar/test_dupMatrix.txt"
            def slopeFile  = "${rustqcDir}/dupradar/test_intercept_slope.txt"
            assert path(matrixFile).exists() : "dupMatrix file not found in: ${rustqcDir}"
            assert path(slopeFile).exists()  : "intercept_slope file not found in: ${rustqcDir}"

            // Snapshot both files for regression tracking
            snapshot(
                matrix: path(matrixFile).readLines(),
                slope:  path(slopeFile).readLines()
            ).match("dupradar_regression")
        }
    }

    // ── Crosscheck: validate RustQC output matches upstream dupRadar ─
    test("dupradar - crosscheck vs upstream") {

        tag "crosscheck"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'unstranded' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def rustqcDir = process.out.results[0][1]
            def matrixFile = "${rustqcDir}/dupradar/test_dupMatrix.txt"
            def slopeFile  = "${rustqcDir}/dupradar/test_intercept_slope.txt"
            assert path(matrixFile).exists() : "dupMatrix file not found in: ${rustqcDir}"
            assert path(slopeFile).exists()  : "intercept_slope file not found in: ${rustqcDir}"

            // dupMatrix: compare count columns only (skip derived rate/RPKM columns)
            // RustQC multi-mapper handling produces slightly different read counts
            // (1-2 reads per gene). The derived rate columns (dupRate, RPK, RPKM)
            // amplify these small count diffs into 50-100% relative errors for
            // low-count genes, making them impractical to compare with tolerance.
            // Columns: 0=ID, 1=geneLength, 2=allCountsMulti, 3=filteredCountsMulti,
            //          4=dupRateMulti, 5=dupsPerIdMulti, 6=RPKMulti, 7=RPKMMulti,
            //          8=allCounts, 9=filteredCounts, 10=dupRate, 11=dupsPerId,
            //          12=RPK, 13=RPKM
            // Skip rate columns 4-7 and 10-13 (derived from counts)
            CompareUtils.tsvMatch(
                path(matrixFile).readLines(),
                path("${projectDir}/snapshots/rna/small/dupradar/dupMatrix.txt").readLines(),
                [tolerance: 10.0, relTolerance: 0.02, skipColumns: [4, 5, 6, 7, 10, 11, 12, 13] as Set]
            )

            // intercept_slope: both tools now use the same format
            // "test - dupRadar Int (duprate at low read counts): <value>"
            // "test - dupRadar Sl (progression of the duplication rate): <value>"
            // Extract numeric values and compare with tolerance
            def actualSlope = path(slopeFile).readLines()
            def upstreamSlope = path("${projectDir}/snapshots/rna/small/dupradar/intercept_slope.txt").readLines()

            def parseSlopeFile = { lines ->
                def vals = [:]
                lines.each { line ->
                    if (line.contains('Int')) vals['intercept'] = (line.split(':')[-1].trim()) as Double
                    if (line.contains('Sl'))  vals['slope']     = (line.split(':')[-1].trim()) as Double
                }
                vals
            }

            def actualVals   = parseSlopeFile(actualSlope)
            def expectedVals = parseSlopeFile(upstreamSlope)

            assert actualVals.intercept != null : "No intercept in RustQC output: ${actualSlope}"
            assert actualVals.slope != null     : "No slope in RustQC output: ${actualSlope}"
            assert expectedVals.intercept != null : "No intercept in upstream output"
            assert expectedVals.slope != null     : "No slope in upstream output"

            // Compare with relative tolerance (count differences propagate)
            def relDiffIntercept = Math.abs(actualVals.intercept - expectedVals.intercept) / Math.abs(expectedVals.intercept)
            def relDiffSlope     = Math.abs(actualVals.slope - expectedVals.slope) / Math.abs(expectedVals.slope)
            assert relDiffIntercept < 0.10 : "intercept relative diff ${relDiffIntercept} exceeds 10%"
            assert relDiffSlope     < 0.10 : "slope relative diff ${relDiffSlope} exceeds 10%"
        }
    }
}
