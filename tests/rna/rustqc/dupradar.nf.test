nextflow_process {

    name "Test RUSTQC dupradar output"
    script "../../../modules/local/rustqc_rna.nf"
    process "RUSTQC_RNA"

    tag "rustqc"
    tag "rna"
    tag "dupradar"
    tag "small"

    // ── Regression: detect changes between RustQC versions ──────────
    test("dupradar - regression") {

        tag "regression"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'unstranded' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def allFiles = process.out.results[0][1].flatten()
            def matrixFile = allFiles.find { it.toString().contains('dupMatrix') }
            def slopeFile  = allFiles.find { it.toString().contains('intercept_slope') }
            assert matrixFile : "dupMatrix file not found in: ${allFiles}"
            assert slopeFile  : "intercept_slope file not found in: ${allFiles}"

            // Snapshot both files for regression tracking
            snapshot(
                matrix: path(matrixFile).readLines(),
                slope:  path(slopeFile).readLines()
            ).match("dupradar_regression")
        }
    }

    // ── Crosscheck: validate RustQC output matches upstream dupRadar ─
    test("dupradar - crosscheck vs upstream") {

        tag "crosscheck"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'unstranded' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def allFiles = process.out.results[0][1].flatten()
            def matrixFile = allFiles.find { it.toString().contains('dupMatrix') }
            def slopeFile  = allFiles.find { it.toString().contains('intercept_slope') }
            assert matrixFile : "dupMatrix file not found in: ${allFiles}"
            assert slopeFile  : "intercept_slope file not found in: ${allFiles}"

            // dupMatrix: numeric match with float precision tolerance (1e-8)
            // Benchmark report confirms: identical except 9th significant figure
            CompareUtils.tsvMatch(
                path(matrixFile).readLines(),
                path("${projectDir}/snapshots/rna/small/dupradar/dupMatrix.txt").readLines(),
                [tolerance: 1e-8]
            )

            // intercept_slope: numeric match with float precision tolerance
            CompareUtils.tsvMatch(
                path(slopeFile).readLines(),
                path("${projectDir}/snapshots/rna/small/dupradar/intercept_slope.txt").readLines(),
                [tolerance: 1e-8]
            )
        }
    }
}
