nextflow_process {

    name "Test RUSTQC dupRadar output"
    script "../../../modules/local/rustqc_rna.nf"
    process "RUSTQC_RNA"

    tag "rustqc"
    tag "rna"
    tag "dupradar"
    tag "small"

    test("small dataset - dupRadar dupMatrix matches upstream") {

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'unstranded' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def allFiles = process.out.results[0][1].flatten()

            def actualMatrix = allFiles.find {
                it.toString().contains('dupMatrix') || it.toString().contains('dup_matrix')
            }
            def actualSlope = allFiles.find {
                it.toString().contains('intercept_slope') || it.toString().contains('slope')
            }

            assert actualMatrix : "dupMatrix not found in: ${allFiles}"
            assert actualSlope : "intercept_slope not found in: ${allFiles}"

            assertAll(
                // dupMatrix: float precision tolerance (last-digit rounding)
                {
                    CompareUtils.tsvMatch(
                        path(actualMatrix).readLines(),
                        path("${projectDir}/snapshots/rna/small/dupradar/dupMatrix.txt").readLines(),
                        [tolerance: 1e-10]
                    )
                },
                // Intercept/slope: check file exists and has content
                // Format differs between RustQC and upstream (different column structure)
                {
                    def slopeLines = path(actualSlope).readLines().findAll { it.trim() }
                    assert slopeLines.size() > 0 : "intercept_slope file is empty"
                },
                // Check plot files exist
                {
                    def plots = allFiles.findAll {
                        it.toString().endsWith('.png') || it.toString().endsWith('.svg')
                    }
                    assert plots.size() > 0 : "No plot files produced"
                }
            )

            // Snapshot for regression tracking
            snapshot(
                matrix: path(actualMatrix).readLines(),
                slope: path(actualSlope).readLines()
            ).match("dupradar_output")
        }
    }
}
