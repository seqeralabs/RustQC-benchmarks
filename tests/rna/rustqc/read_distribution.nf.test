nextflow_process {

    name "Test RUSTQC read_distribution output"
    script "../../../modules/local/rustqc_rna.nf"
    process "RUSTQC_RNA"

    tag "rustqc"
    tag "rna"
    tag "read_distribution"
    tag "small"

    // ── Regression: detect changes between RustQC versions ──────────
    test("read_distribution - regression") {

        tag "regression"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'unstranded' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def allFiles = process.out.results[0][1].flatten()
            def actualFile = allFiles.find { it.toString().endsWith('read_distribution.txt') }
            assert actualFile : "read_distribution.txt not found in: ${allFiles}"

            // Snapshot full content for regression tracking
            snapshot(path(actualFile).readLines()).match("read_distribution_regression")
        }
    }

    // ── Crosscheck: validate RustQC output matches upstream RSeQC ───
    test("read_distribution - crosscheck vs upstream") {

        tag "crosscheck"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'unstranded' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def allFiles = process.out.results[0][1].flatten()
            def actualFile = allFiles.find { it.toString().endsWith('read_distribution.txt') }
            assert actualFile : "read_distribution.txt not found in: ${allFiles}"

            // Exact text match against upstream reference
            // Benchmark report confirms: identical on small dataset
            CompareUtils.textMatch(
                path(actualFile).readLines(),
                path("${projectDir}/snapshots/rna/small/rseqc/read_distribution/read_distribution.txt").readLines()
            )
        }
    }
}
