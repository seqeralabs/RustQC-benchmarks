nextflow_process {

    name "Test RUSTQC read_distribution output"
    script "../../../modules/local/rustqc_rna.nf"
    process "RUSTQC_RNA"

    tag "rustqc"
    tag "rna"
    tag "read_distribution"
    tag "small"

    // ── Regression: detect changes between RustQC versions ──────────
    test("read_distribution - regression") {

        tag "regression"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'reverse' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def rustqcDir = process.out.results[0][1]
            def actualFile = "${rustqcDir}/rseqc/read_distribution/test.read_distribution.txt"
            assert path(actualFile).exists() : "read_distribution.txt not found in: ${rustqcDir}"

            // Snapshot full content for regression tracking
            snapshot(path(actualFile).readLines()).match("read_distribution_regression")
        }
    }

    // ── Crosscheck: validate RustQC output matches upstream RSeQC ───
    test("read_distribution - crosscheck vs upstream") {

        tag "crosscheck"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'reverse' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def rustqcDir = process.out.results[0][1]
            def actualFile = "${rustqcDir}/rseqc/read_distribution/test.read_distribution.txt"
            assert path(actualFile).exists() : "read_distribution.txt not found in: ${rustqcDir}"

            // Byte-identical to RSeQC read_distribution.py (run on the GTF2BED-derived BED,
            // as the pipeline does), trailing spaces of its table rows included.
            def upstreamFile = "${projectDir}/snapshots/rna/small/rseqc/read_distribution/read_distribution.txt"
            if (path(actualFile).md5 != path(upstreamFile).md5) {
                ExactCompare.exactMatch(path(actualFile).readLines(), path(upstreamFile).readLines())
                assert false : "read_distribution.txt differs from upstream in line endings only"
            }
        }
    }
}
