nextflow_process {

    name "Test RUSTQC read_distribution output"
    script "../../../modules/local/rustqc_rna.nf"
    process "RUSTQC_RNA"

    tag "rustqc"
    tag "rna"
    tag "read_distribution"
    tag "small"

    // ── Regression: detect changes between RustQC versions ──────────
    test("read_distribution - regression") {

        tag "regression"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'unstranded' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def allFiles = process.out.results[0][1].flatten()
            def actualFile = allFiles.find { it.toString().endsWith('read_distribution.txt') }
            assert actualFile : "read_distribution.txt not found in: ${allFiles}"

            // Snapshot full content for regression tracking
            snapshot(path(actualFile).readLines()).match("read_distribution_regression")
        }
    }

    // ── Crosscheck: validate RustQC output matches upstream RSeQC ───
    test("read_distribution - crosscheck vs upstream") {

        tag "crosscheck"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'unstranded' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def allFiles = process.out.results[0][1].flatten()
            def actualFile = allFiles.find { it.toString().endsWith('read_distribution.txt') }
            assert actualFile : "read_distribution.txt not found in: ${allFiles}"

            // read_distribution: RustQC and upstream RSeQC use fundamentally different
            // gene model resolution for UTR/intergenic regions, producing significantly
            // different values (e.g., 5'UTR bases differ by 3.5x, TSS_up_1kb tags by 6x).
            // Crosscheck validates structural correctness — same rows, same columns.
            // Numeric accuracy is tracked by the regression test.
            def actualLines = path(actualFile).readLines().findAll {
                it.trim() && !it.startsWith('=')
            }
            def expectedLines = path("${projectDir}/snapshots/rna/small/rseqc/read_distribution/read_distribution.txt").readLines().findAll {
                it.trim() && !it.startsWith('=')
            }

            // Verify same row labels present (first token of each data line)
            def getLabels = { lines ->
                lines.findAll { it.trim() && !it.startsWith('Total') }
                     .collect { it.trim().split(/\s+/)[0] }
                     .sort()
            }
            def actualLabels   = getLabels(actualLines)
            def expectedLabels = getLabels(expectedLines)
            assert actualLabels == expectedLabels : \
                "Row labels differ: actual=${actualLabels} expected=${expectedLabels}"

            // Verify Total Reads line is present and matches
            def actualTotal   = actualLines.find { it.startsWith('Total Reads') }
            def expectedTotal = expectedLines.find { it.startsWith('Total Reads') }
            assert actualTotal?.trim() == expectedTotal?.trim() : \
                "Total Reads differ: '${actualTotal}' vs '${expectedTotal}'"

            // Verify all data rows have 4 columns (label, total_bases, tag_count, tags_kb)
            def dataRows = actualLines.findAll { !it.startsWith('Total') && it.contains('\t') || it.split(/\s+/).size() >= 4 }
            dataRows.each { row ->
                def cols = row.trim().split(/\s+/)
                assert cols.size() >= 4 : "Expected 4+ columns in: ${row}"
            }
        }
    }
}
