nextflow_process {

    name "Test RUSTQC featurecounts output"
    script "../../../modules/local/rustqc_rna.nf"
    process "RUSTQC_RNA"

    tag "rustqc"
    tag "rna"
    tag "featurecounts"
    tag "small"

    // ── Regression: detect changes between RustQC versions ──────────
    test("featurecounts - regression") {

        tag "regression"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'reverse' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def rustqcDir = process.out.results[0][1]
            def biotypeFile = "${rustqcDir}/featurecounts/test.biotype_counts.tsv"
            def summaryFile = "${rustqcDir}/featurecounts/test.featureCounts.tsv.summary"
            assert path(biotypeFile).exists() : "biotype_counts.tsv not found in: ${rustqcDir}"
            assert path(summaryFile).exists() : "featureCounts .summary not found in: ${rustqcDir}"

            // Snapshot biotype counts and summary for regression tracking
            snapshot(
                counts:  path(biotypeFile).readLines(),
                summary: path(summaryFile).readLines()
            ).match("featurecounts_regression")
        }
    }

    // ── Crosscheck: validate RustQC biotype counts against upstream ────
    // Reference: featureCounts -g gene_biotype (one meta-feature per biotype, so a
    // read overlapping two genes of the same biotype is not ambiguous). RustQC
    // reproduces this biotype-level counting: counts and summary match exactly.
    test("featurecounts - crosscheck vs upstream") {

        tag "crosscheck"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'reverse' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def rustqcDir = process.out.results[0][1]
            def biotypeFile = "${rustqcDir}/featurecounts/test.biotype_counts.tsv"
            def summaryFile = "${rustqcDir}/featurecounts/test.featureCounts.biotype.tsv.summary"
            assert path(biotypeFile).exists() : "biotype_counts.tsv not found in: ${rustqcDir}"
            assert path(summaryFile).exists() : "featureCounts.biotype.tsv.summary not found in: ${rustqcDir}"

            def upstreamDir = "${projectDir}/snapshots/rna/small/featurecounts"

            // ── Biotype counts ────────────────────────────────────────────
            // Upstream: featureCounts -g gene_biotype, 7 columns (col 0 = biotype,
            // col 6 = count). RustQC: 2-column biotype_counts.tsv (Biotype, Count).
            // Measured: all 14 biotype counts identical.
            def actualBiotypes = [:]
            path(biotypeFile).readLines().each { line ->
                if (line.startsWith('Biotype')) return
                def parts = line.split('\t')
                if (parts.size() >= 2) actualBiotypes[parts[0]] = parts[1].trim() as Integer
            }
            def expectedBiotypes = [:]
            path("${upstreamDir}/featureCounts.tsv").readLines().each { line ->
                if (line.startsWith('#') || line.startsWith('Geneid')) return
                def parts = line.split('\t')
                if (parts.size() >= 7) expectedBiotypes[parts[0]] = parts[6].trim() as Integer
            }
            assert expectedBiotypes : "No biotype counts parsed from upstream reference"
            def biotypeDiffs = (actualBiotypes.keySet() + expectedBiotypes.keySet()).findAll {
                actualBiotypes[it] != expectedBiotypes[it]
            }.collect { "${it}: RustQC=${actualBiotypes[it]} upstream=${expectedBiotypes[it]}" }
            assert !biotypeDiffs : \
                "Biotype counts differ from featureCounts -g gene_biotype:\n  " + biotypeDiffs.join('\n  ')

            // ── Summary ───────────────────────────────────────────────────
            // RustQC writes a biotype-level summary alongside the per-gene one.
            // Measured: byte-identical to the featureCounts -g gene_biotype summary.
            // (The per-gene summary is checked against featureCounts -g gene_id in
            // the next test.)
            assert path(summaryFile).md5 == path("${upstreamDir}/featureCounts.tsv.summary").md5 : \
                "Biotype-level summary differs from featureCounts -g gene_biotype summary"
        }
    }

    // ── Crosscheck: validate RustQC per-gene counts against upstream ───
    // Reference: featureCounts -g gene_id. Counts, Length and the summary match
    // exactly; only the order of per-exon annotation entries differs.
    test("featurecounts - crosscheck per-gene counts vs upstream") {

        tag "crosscheck"
        tag "featurecounts_geneid"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'reverse' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def rustqcDir = process.out.results[0][1]
            def countsFile  = "${rustqcDir}/featurecounts/test.featureCounts.tsv"
            def summaryFile = "${rustqcDir}/featurecounts/test.featureCounts.tsv.summary"
            assert path(countsFile).exists()  : "featureCounts.tsv not found in: ${rustqcDir}"
            assert path(summaryFile).exists() : "featureCounts.tsv.summary not found in: ${rustqcDir}"

            def upstreamDir = "${projectDir}/snapshots/rna/small/featurecounts_geneid"
            def actualLines   = path(countsFile).readLines()
            def expectedLines = path("${upstreamDir}/test.featureCounts.tsv").readLines()

            // ── Per-gene counts ───────────────────────────────────────────
            // Columns: 0=Geneid, 1=Chr, 2=Start, 3=End, 4=Strand, 5=Length, 6=count.
            // Measured: Geneid, Length and count identical for all 2,905 genes (0 count
            // differences). Compared exactly; the '#' line is the program/command header.
            CompareUtils.tsvMatch(actualLines, expectedLines, [
                skipColumns:  [1, 2, 3, 4] as Set,  // checked as exon sets below
                skipPrefixes: ['#'],
            ])

            // KNOWN DISCREPANCY (cosmetic): Chr/Start/End/Strand hold one ';'-separated
            // entry per exon. RustQC lists exons in GTF order, Subread sorts them by
            // position, so 1,316 genes differ in order only. Compare each gene's exons
            // as a sorted list of chr:start:end:strand.
            def exonSets = { lines ->
                lines.findAll { !it.startsWith('#') && !it.startsWith('Geneid') }.collectEntries { line ->
                    def cols  = line.split('\t')
                    def parts = (1..4).collect { cols[it].split(';') }
                    def exons = (0..<parts[0].size()).collect { i -> parts.collect { it[i] }.join(':') }
                    [(cols[0]): exons.sort()]
                }
            }
            def actualExons   = exonSets(actualLines)
            def expectedExons = exonSets(expectedLines)
            def exonDiffs = expectedExons.keySet().findAll { actualExons[it] != expectedExons[it] }
            assert !exonDiffs : \
                "Exon annotation differs beyond ordering for ${exonDiffs.size()} genes, e.g. ${exonDiffs.take(5)}"

            // ── Per-gene summary ──────────────────────────────────────────
            // Measured: byte-identical to featureCounts -g gene_id.
            assert path(summaryFile).md5 == path("${upstreamDir}/test.featureCounts.tsv.summary").md5 : \
                "featureCounts.tsv.summary differs from upstream featureCounts -g gene_id"
        }
    }
}
