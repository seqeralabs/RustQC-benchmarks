nextflow_process {

    name "Test RUSTQC featurecounts output"
    script "../../../modules/local/rustqc_rna.nf"
    process "RUSTQC_RNA"

    tag "rustqc"
    tag "rna"
    tag "featurecounts"
    tag "small"

    // ── Regression: detect changes between RustQC versions ──────────
    test("featurecounts - regression") {

        tag "regression"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'unstranded' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def allFiles = process.out.results[0][1].flatten()
            def biotypeFile = allFiles.find { it.toString().endsWith('biotype_counts.tsv') }
            def summaryFile = allFiles.find { it.toString().endsWith('.tsv.summary') }
            assert biotypeFile : "biotype_counts.tsv not found in: ${allFiles}"
            assert summaryFile : "featureCounts .summary not found in: ${allFiles}"

            // Snapshot biotype counts and summary for regression tracking
            snapshot(
                counts:  path(biotypeFile).readLines(),
                summary: path(summaryFile).readLines()
            ).match("featurecounts_regression")
        }
    }

    // ── Crosscheck: validate RustQC biotype counts against upstream ────
    // Upstream runs featureCounts with `-g gene_biotype` (one row per biotype).
    // RustQC counts per-gene then aggregates by biotype attribute.
    // These approaches handle ambiguous reads differently:
    //   - Upstream: exons of same biotype merge → read overlapping two genes of
    //     same biotype is NOT ambiguous
    //   - RustQC: counts per gene_id first → same read IS ambiguous
    // This causes ~6% fewer Assigned reads in RustQC (shifted to Ambiguity).
    test("featurecounts - crosscheck vs upstream") {

        tag "crosscheck"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'unstranded' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def allFiles = process.out.results[0][1].flatten()
            def biotypeFile = allFiles.find { it.toString().endsWith('biotype_counts.tsv') }
            def summaryFile = allFiles.find { it.toString().endsWith('.tsv.summary') }
            assert biotypeFile : "biotype_counts.tsv not found in: ${allFiles}"
            assert summaryFile : "featureCounts .summary not found in: ${allFiles}"

            def upstreamDir = "${projectDir}/snapshots/rna/small/featurecounts"

            // ── Biotype counts comparison ─────────────────────────────────
            // Upstream: 7-col featureCounts output with -g gene_biotype
            //   → extract col 1 (biotype) and col 7 (count)
            // RustQC: 2-col biotype_counts.tsv (Biotype\tCount)

            // Parse RustQC biotype counts (skip header)
            def actualBiotypes = [:]
            path(biotypeFile).readLines().each { line ->
                if (line.startsWith('Biotype')) return
                def parts = line.split('\t')
                if (parts.size() >= 2) actualBiotypes[parts[0]] = parts[1].trim() as Integer
            }

            // Parse upstream biotype counts (skip comment + header, extract col 1 & 7)
            def expectedBiotypes = [:]
            path("${upstreamDir}/featureCounts.tsv").readLines().each { line ->
                if (line.startsWith('#') || line.startsWith('Geneid')) return
                def parts = line.split('\t')
                if (parts.size() >= 7) expectedBiotypes[parts[0]] = parts[6].trim() as Integer
            }

            // Same set of biotypes
            assert actualBiotypes.keySet().sort() == expectedBiotypes.keySet().sort() : \
                "Biotype sets differ: RustQC=${actualBiotypes.keySet().sort()} upstream=${expectedBiotypes.keySet().sort()}"

            // Compare per-biotype counts with tolerance
            // Most biotypes match exactly; protein_coding differs ~6% due to
            // ambiguity resolution; pseudogene ~16%; lincRNA ~2%.
            def mismatches = []
            actualBiotypes.each { biotype, actual ->
                def expected = expectedBiotypes[biotype]
                if (actual != expected) {
                    def relDiff = expected > 0 ? Math.abs(actual - expected) / expected : (actual > 0 ? 1.0 : 0.0)
                    mismatches << "${biotype}: RustQC=${actual} upstream=${expected} (${String.format('%.1f', relDiff * 100)}%)"
                    // Fail if any biotype differs by more than 20%
                    // (accounts for small-count biotypes where 1-read diff = large %)
                    assert relDiff <= 0.20 || Math.abs(actual - expected) <= 5 : \
                        "${biotype} exceeds tolerance: RustQC=${actual} upstream=${expected} (${String.format('%.1f', relDiff * 100)}%)"
                }
            }

            // Verify zero-count biotypes agree exactly
            expectedBiotypes.each { biotype, expected ->
                if (expected == 0) {
                    assert actualBiotypes[biotype] == 0 : \
                        "${biotype} should be 0 but RustQC reports ${actualBiotypes[biotype]}"
                }
            }

            // ── Summary comparison ────────────────────────────────────────
            def actualSummary   = path(summaryFile).readLines().findAll { it.trim() }
            def expectedSummary = path("${upstreamDir}/featureCounts.tsv.summary").readLines().findAll { it.trim() }

            // Same row labels
            def actualLabels   = actualSummary.collect { it.split('\t')[0] }
            def expectedLabels = expectedSummary.collect { it.split('\t')[0] }
            assert actualLabels == expectedLabels : \
                "Summary labels differ: ${actualLabels} vs ${expectedLabels}"

            // Zero-value rows must agree
            expectedSummary.eachWithIndex { line, i ->
                if (i == 0) return  // skip header
                def parts = line.split('\t')
                def aParts = actualSummary[i].split('\t')
                if (parts.size() >= 2 && aParts.size() >= 2) {
                    try {
                        def ev = parts[1].trim() as Integer
                        def av = aParts[1].trim() as Integer
                        if (ev == 0) {
                            assert av == 0 : "Expected 0 for ${actualLabels[i]}, got ${av}"
                        }
                    } catch (NumberFormatException e) { /* skip header */ }
                }
            }
        }
    }
}
