nextflow_process {

    name "Test RUSTQC inner_distance output"
    script "../../../modules/local/rustqc_rna.nf"
    process "RUSTQC_RNA"

    tag "rustqc"
    tag "rna"
    tag "inner_distance"
    tag "small"

    // ── Regression: detect changes between RustQC versions ──────────
    test("inner_distance - regression") {

        tag "regression"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'unstranded' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def allFiles = process.out.results[0][1].flatten()
            def distFile = allFiles.find { it.toString().endsWith('.inner_distance.txt') }
            def freqFile = allFiles.find { it.toString().endsWith('_freq.txt') }
            assert distFile : ".inner_distance.txt not found in: ${allFiles}"
            assert freqFile : "_freq.txt not found in: ${allFiles}"

            // Snapshot both files for regression tracking
            snapshot(
                distance: path(distFile).readLines(),
                freq:     path(freqFile).readLines()
            ).match("inner_distance_regression")
        }
    }

    // ── Crosscheck: validate RustQC output matches upstream RSeQC ───
    test("inner_distance - crosscheck vs upstream") {

        tag "crosscheck"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'unstranded' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def allFiles = process.out.results[0][1].flatten()
            def distFile = allFiles.find { it.toString().endsWith('.inner_distance.txt') }
            def freqFile = allFiles.find { it.toString().endsWith('_freq.txt') }
            assert distFile : ".inner_distance.txt not found in: ${allFiles}"
            assert freqFile : "_freq.txt not found in: ${allFiles}"

            def upstreamDir = "${projectDir}/snapshots/rna/small/rseqc/inner_distance"

            // Exact TSV match for distance data
            // Benchmark report confirms: identical on small dataset
            CompareUtils.tsvMatch(
                path(distFile).readLines(),
                path("${upstreamDir}/inner_distance.txt").readLines(),
                [tolerance: 0.0]
            )

            // Exact TSV match for frequency data
            CompareUtils.tsvMatch(
                path(freqFile).readLines(),
                path("${upstreamDir}/inner_distance_freq.txt").readLines(),
                [tolerance: 0.0]
            )
        }
    }
}
