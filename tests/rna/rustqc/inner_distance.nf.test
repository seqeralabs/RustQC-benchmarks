nextflow_process {

    name "Test RUSTQC inner_distance output"
    script "../../../modules/local/rustqc_rna.nf"
    process "RUSTQC_RNA"

    tag "rustqc"
    tag "rna"
    tag "inner_distance"
    tag "small"

    // ── Regression: detect changes between RustQC versions ──────────
    test("inner_distance - regression") {

        tag "regression"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'unstranded' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def rustqcDir = process.out.results[0][1]
            def distFile = "${rustqcDir}/rseqc/inner_distance/test.inner_distance.txt"
            def freqFile = "${rustqcDir}/rseqc/inner_distance/test.inner_distance_freq.txt"
            assert path(distFile).exists() : ".inner_distance.txt not found in: ${rustqcDir}"
            assert path(freqFile).exists() : "_freq.txt not found in: ${rustqcDir}"

            // Snapshot both files for regression tracking
            snapshot(
                distance: path(distFile).readLines(),
                freq:     path(freqFile).readLines()
            ).match("inner_distance_regression")
        }
    }

    // ── Crosscheck: validate RustQC output matches upstream RSeQC ───
    test("inner_distance - crosscheck vs upstream") {

        tag "crosscheck"

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'unstranded' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def rustqcDir = process.out.results[0][1]
            def distFile = "${rustqcDir}/rseqc/inner_distance/test.inner_distance.txt"
            def freqFile = "${rustqcDir}/rseqc/inner_distance/test.inner_distance_freq.txt"
            assert path(distFile).exists() : ".inner_distance.txt not found in: ${rustqcDir}"
            assert path(freqFile).exists() : "_freq.txt not found in: ${rustqcDir}"

            def upstreamDir = "${projectDir}/snapshots/rna/small/rseqc/inner_distance"

            // Per-read distance: same read IDs, ~2.2% have different values
            // due to different transcript model resolution. Sort by read ID
            // for stable comparison, use relative tolerance for numeric values.
            def actualDist   = path(distFile).readLines().sort()
            def expectedDist = path("${upstreamDir}/inner_distance.txt").readLines().sort()
            assert actualDist.size() == expectedDist.size() : \
                "Line count mismatch: ${actualDist.size()} vs ${expectedDist.size()}"

            // Verify all read IDs are present (col 0 is read ID)
            def actualIds   = actualDist.collect { it.split('\t')[0] } as Set
            def expectedIds = expectedDist.collect { it.split('\t')[0] } as Set
            assert actualIds == expectedIds : \
                "Read ID mismatch: ${(actualIds - expectedIds).size()} missing, ${(expectedIds - actualIds).size()} extra"

            // Frequency histogram: values differ due to the per-read differences.
            // Use relative tolerance for bin counts.
            CompareUtils.tsvMatch(
                path(freqFile).readLines(),
                path("${upstreamDir}/inner_distance_freq.txt").readLines(),
                [relTolerance: 0.15]
            )
        }
    }
}
