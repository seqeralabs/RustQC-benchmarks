nextflow_process {

    name "Test RUSTQC inner_distance output"
    script "../../modules/local/rustqc_rna.nf"
    process "RUSTQC_RNA"

    tag "rna"
    tag "inner_distance"
    tag "small"

    test("small dataset - inner_distance matches upstream RSeQC") {

        when {
            params {
                skip_dup_check = true
            }
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false, strandedness: 'unstranded' ],
                    file("${projectDir}/test-data/rna/small/test.bam", checkIfExists: true),
                    file("${projectDir}/test-data/rna/small/test.bam.bai", checkIfExists: true)
                ])
                input[1] = file("${projectDir}/test-data/rna/small/chr6.gtf.gz", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def rseqcFiles = process.out.results[0][1].flatten()

            // Inner distance raw data
            def actualDist = rseqcFiles.find {
                it.toString().contains('inner_distance') &&
                it.toString().endsWith('.inner_distance.txt')
            }

            // Inner distance frequency table
            def actualFreq = rseqcFiles.find {
                it.toString().contains('inner_distance') &&
                it.toString().endsWith('_freq.txt')
            }

            assertAll(
                {
                    assert actualDist : "inner_distance.txt not found in RUSTQC_RNA rseqc output"
                    CompareUtils.tsvMatch(
                        path(actualDist).readLines(),
                        path("${projectDir}/snapshots/rna/small/rseqc/inner_distance.inner_distance.txt").readLines(),
                        [tolerance: 0.0]
                    )
                },
                {
                    assert actualFreq : "inner_distance_freq.txt not found in RUSTQC_RNA rseqc output"
                    CompareUtils.tsvMatch(
                        path(actualFreq).readLines(),
                        path("${projectDir}/snapshots/rna/small/rseqc/inner_distance.inner_distance_freq.txt").readLines(),
                        [tolerance: 0.0]
                    )
                }
            )
        }
    }
}
