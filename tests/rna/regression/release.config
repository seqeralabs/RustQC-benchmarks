/*
 * Config for tests/rna/regression/release.nf.test.
 *
 * BASELINE:RUSTQC_RNA runs the last released RustQC image. The test sets
 * params.rustqc_baseline_image from release_regression.baseline_image in tests/datasets.yml
 * (or $RUSTQC_BASELINE_IMAGE). CURRENT:RUSTQC_RNA keeps the module's own container
 * (params.rustqc_image).
 *
 * Without containers, the test can instead put two local binaries first on PATH
 * ($RUSTQC_BASELINE_BIN / $RUSTQC_CURRENT_BIN, passed in as params.rustqc_baseline_bin and
 * params.rustqc_current_bin). beforeScript runs in the host environment, so this only takes
 * effect when no container engine is enabled.
 */
process {
    withName: '.*:BASELINE:RUSTQC_RNA' {
        container    = { params.rustqc_baseline_image }
        beforeScript = { params.rustqc_baseline_bin ? "export PATH=\"${params.rustqc_baseline_bin}:\$PATH\"" : '' }
    }
    withName: '.*:CURRENT:RUSTQC_RNA' {
        beforeScript = { params.rustqc_current_bin ? "export PATH=\"${params.rustqc_current_bin}:\$PATH\"" : '' }
    }
}
