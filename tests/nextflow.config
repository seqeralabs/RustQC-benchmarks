/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

// TODO nf-core: Specify any additional parameters here
// Or any resources requirements
params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/rustqc-benchmarks'

    // Allow overriding the RustQC container for pre-release testing, e.g. to
    // validate features not yet in ghcr.io/seqeralabs/rustqc:dev (such as the
    // bigWig tracks from RustQC PR #114):
    //   RUSTQC_IMAGE=ghcr.io/seqeralabs/rustqc:<tag> nf-test test --tag bigwig
    rustqc_image = System.getenv('RUSTQC_IMAGE') ?: 'ghcr.io/seqeralabs/rustqc:dev'
}

aws.client.anonymous = true // fixes S3 access issues on self-hosted runners
