/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

// TODO nf-core: Specify any additional parameters here
// Or any resources requirements
params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/rustqc-benchmarks/'
}

// Fixes S3 access issues on self-hosted runners
aws.client.anonymous = true

process {
    // CI only: also retry tasks whose container failed to pull/start (docker exit 125, e.g. "connection reset by peer" from the registry).
    // Same codes as the nf-core template's base.config plus 125; one retry keeps permanent 125 errors (bad docker.runOptions) cheap.
    errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177) + 125) && task.attempt <= task.maxRetries ? 'retry' : 'finish' }
    maxRetries    = 1
}
